# Copy to .env and set your Groq API key before: docker compose up --build

GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.1-8b-instant

# Used by the Next.js build (browser → backend on host)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend → agent (overridden in docker-compose to http://agent:8001)
AGENT_URL=http://localhost:8001
